{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/pngen/aigos/schemas/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Supported AIGOSD configuration version"
    },
    "meshes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "layers": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "items": {
                "type": "string",
                "enum": ["dio", "zt-aas", "icae", "poc", "fak", "are", "jib", "icl", "gsas", "able"]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logging": {
          "type": "string",
          "enum": ["structured", "plaintext"],
          "default": "plaintext"
        },
        "restart": {
          "type": "string",
          "enum": ["on-failure", "never", "always"],
          "default": "on-failure"
        },
        "log_file": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "pattern": "^(?:[\\\\/]|[A-Za-z]:)"
              }
            },
            {
              "not": {
                "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
              }
            },
            {
              "not": {
                "pattern": "^(?:\\.(?:[\\\\/]+|$))+$"
              }
            }
          ],
          "description": "Optional nonempty relative path without parent traversal. Existing-parent, symlink, hard-link, and opened-file identity checks are enforced at runtime."
        }
      },
      "required": ["logging", "restart"]
    }
  },
  "required": ["meshes", "options"]
}
